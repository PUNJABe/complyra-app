# Local development only. Copy to .env.local; never commit real secrets.
APP_ORIGIN=http://localhost:3000
COMPLYRA_STORAGE_MODE=json
# Optional in development, mandatory in production: 64 random hex characters.
DATA_ENCRYPTION_KEY=
# Local verification/reset emails appear in .complyra/secure/mail-outbox.
# Set smtp for real email. Outbox is rejected in production.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# First register and verify these addresses to bootstrap an administrator.
ADMIN_EMAILS=
AUTH_ALLOWLIST_ONLY=false
AUTH_ALLOWLIST=
AUTH_BLOCKLIST=
# Only set when your trusted ingress overwrites this header.
TRUSTED_CLIENT_IP_HEADER=

# Oracle Autonomous Database / Always Free deployment
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Optional registered entity name; public pages use the Complyra service name when blank.
LEGAL_ENTITY_NAME=
# Production registration requires published policies and a working contact address.
PRIVACY_CONTACT_EMAIL=
LEGAL_POLICIES_APPROVED=false

# Optional external AI. Users must separately opt in in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Separate random scheduler secret, at least 32 characters.
CRON_SECRET=
# Existing optional delivery integrations. Admins only can trigger delivery.
SLACK_WEBHOOK_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
